# ---------- Data Server (MariaDB) ----------
# 형식: mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME?charset=utf8mb4
# 로컬 개발용 SQLite: sqlite:////data/cake.db
DATABASE_URL=mysql+pymysql://cake_app:CHANGE_ME@db.example.com:3306/cake?charset=utf8mb4

# ---------- 서버 주소 ----------
DETECTOR_URL=http://detector:3001
BACKEND_URL=http://backend:8000
PUBLIC_BASE_URL=http://localhost:8000

# ---------- 분석 ----------
DEFAULT_MODE=high
MAX_UPLOAD_MB=300
ALLOWED_EXTENSIONS=mp4,avi,mov,mkv,webm,wmv
FFMPEG_PATH=ffmpeg

# ---------- 보안 ----------
INTERNAL_API_TOKEN=CHANGE_ME_random_32_bytes
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------- AI Hub 학습 데이터 (scripts/aihub_pipeline.sh · docker-compose.aihub.yml) ----------
# 기본값 없음 — 학습하려면 반드시 지정. 003.딥페이크/ 가 바로 아래에 있는 호스트 디렉터리
AIHUB_DATA_DIR=/mnt/<디스크>/<AI Hub 폴더>
# (선택) 마운트 지점을 지정하면 파이프라인이 마운트 여부를 확인하고, UUID 가 있으면 자동 마운트
AIHUB_MOUNT=
AIHUB_DISK_UUID=
